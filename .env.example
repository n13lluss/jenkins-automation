# Local development secrets for compose.yaml. Generate real values with scripts/dev-env.sh.
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# OIDC client secret shared by Keycloak and the frontend.
PF_CLIENT_SECRET=
# Password for the demo users alice (create a workspace → admin), bob and victor. 12+ characters.
PF_DEMO_PASSWORD=
# 32+ characters; encrypts the session cookie.
SESSION_SECRET=
JENKINS_ADMIN_PASSWORD=
# Outbound rules for user-supplied URLs (SCM, Jenkins, AI). Keep false unless you call internal hosts.
OUTBOUND_ALLOW_HTTP=false
OUTBOUND_ALLOW_PRIVATE=false
OUTBOUND_PRIVATE_HOST=jenkins
