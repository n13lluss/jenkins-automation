# Copy to .env.local for `npm run dev` outside docker compose.
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
OIDC_ISSUER=http://localhost:8081/realms/pipelineforge
OIDC_AUTHORIZATION_URL=http://localhost:8081/realms/pipelineforge/protocol/openid-connect/auth
OIDC_TOKEN_URL=http://localhost:8081/realms/pipelineforge/protocol/openid-connect/token
OIDC_JWKS_URL=http://localhost:8081/realms/pipelineforge/protocol/openid-connect/certs
OIDC_END_SESSION_URL=http://localhost:8081/realms/pipelineforge/protocol/openid-connect/logout
OIDC_CLIENT_ID=pipelineforge-web
OIDC_CLIENT_SECRET=
