{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Auth": {
    "Authority": "",
    "MetadataAddress": "",
    "Audience": "pipelineforge-api",
    "RequireHttpsMetadata": true,
    "WorkspaceCreators": []
  },
  "SecretStore": {
    "Provider": "vault",
    "Vault": {
      "Address": "http://vault:8200",
      "MountPoint": "secret",
      "PathPrefix": "pipelineforge"
    },
    "AzureKeyVault": {
      "VaultUri": ""
    }
  },
  "Outbound": {
    "AllowPrivateNetworks": false,
    "AllowHttp": false,
    "AllowedHosts": [],
    "UseProxy": false
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
